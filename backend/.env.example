# PhishTrace Backend Configuration
PHISHTRACE_HOST=127.0.0.1
PHISHTRACE_PORT=8000
SECRET_KEY=replace-with-a-secure-random-secret-key

# Open-Source AI Configuration
# Modes: nvidia | groq | fallback
AI_PROVIDER=nvidia
OPENSOURCE_MODEL_NAME=meta/llama-3.2-11b-vision-instruct

# NVIDIA NIM Cloud API Key (Optional - get your free key at https://build.nvidia.com)
NVIDIA_API_KEY=
GROQ_API_KEY=

# Google Read-Only Gmail OAuth Configuration (Optional - offline demo & .eml upload active if empty)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/integrations/gmail/callback
